{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCluely",
  "version": "1.0.0",
  "identifier": "com.opencluely.app",
  "build": {
    "frontendDist": "../",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenCluely",
        "url": "index.html",
        "width": 520,
        "height": 35,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "response",
        "title": "AI Response",
        "url": "llm-response.html",
        "width": 840,
        "height": 480,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "chat",
        "title": "Chat",
        "url": "chat.html",
        "width": 500,
        "height": 700,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Settings",
        "url": "settings.html",
        "width": 400,
        "height": 480,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "onboarding",
        "title": "Welcome to OpenCluely",
        "url": "onboarding.html",
        "width": 560,
        "height": 680,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
